// প্রতারক চেক — database schema (PostgreSQL / Supabase)
// Tables are also provided as raw SQL in create_tables.sql for manual setup.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One user-submitted fraud report against a phone number.
/// A report is only visible publicly after moderation (status = "approved").
/// The reporter's own phone number is PRIVATE and never exposed by any API.
model Report {
  id            Int       @id @default(autoincrement())
  phone         String // normalized scammer number: 01XXXXXXXXX
  channel       String // bkash | nagad | rocket | bank | p2p | call | shop | other
  scamType      String // free short label chosen from the form list
  amount        Int? // taka lost (optional)
  incidentDate  String? // YYYY-MM-DD (optional)
  description   String // what happened (public once approved)
  trxId         String? // transaction id as supporting proof (private)
  evidence      String? // JSON array of base64 data URLs, up to 5 screenshots (private, moderation only)
  reporterPhone String // reporter's own number (private, for follow-up only)
  status        String    @default("pending") // pending | approved | rejected | hidden (অফ, প্রমাণ থাকে) | withdrawn (প্রত্যাহার)
  createdAt     DateTime  @default(now())
  reviewedAt    DateTime?

  @@index([phone, status])
  @@index([status, createdAt])
}

/// Objection from a number's owner. While a dispute is "open", the number's
/// public profile is softened to "আপত্তি পর্যালোচনাধীন" until resolved.
model Dispute {
  id         Int       @id @default(autoincrement())
  phone      String
  reason     String
  contact    String // how to reach the objector (private)
  status     String    @default("open") // open | removed | kept
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([phone, status])
}

/// Anonymous search counter (no user data) for simple usage stats.
model CheckLog {
  id        Int      @id @default(autoincrement())
  phone     String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// One-tap "আমার সাথেও হয়েছে" from other victims of the same number.
/// Anonymous; only a hashed IP is kept, purely as a 24h duplicate guard.
model MeToo {
  id        Int      @id @default(autoincrement())
  phone     String
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

/// Permanent audit trail of every admin action on a report (approve, reject,
/// hide/off, withdraw, restore, edit, dispute outcomes). Rows are never
/// deleted — this is the proof of what was done, and when.
model AdminLog {
  id        Int      @id @default(autoincrement())
  reportId  Int?
  phone     String?
  action    String // approve | reject | hide | withdraw | restore | edit | dispute_remove | dispute_keep
  detail    String?
  createdAt DateTime @default(now())

  @@index([reportId])
  @@index([createdAt])
}

/// One row per browser session visit (path only, no user data) for daily
/// visitor counts in the admin dashboard.
model VisitLog {
  id        Int      @id @default(autoincrement())
  path      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
